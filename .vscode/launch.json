{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug UFC5 from startup",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\_Build\\windows\\install\\kyty_emulator.exe",
            "args": [
                "--game", "E:/EA SPORTS UFC 5 01.031 PPSA03541 [DLPSGAME.COM]",
                "--printf-direction", "Silent",
                "--shader-log-direction", "Silent",
                "--vulkan-validation", "false",
                "--gpu-assisted-validation", "false",
                "--shader-validation", "false",
                "--graphics-debug-dump", "false",
                "--command-buffer-dump", "false",
                "--amd-cpu"
            ],
            "cwd": "${workspaceFolder}\\_Build\\ufc5\\runtime",
            "stopAtEntry": false,
            "externalConsole": false,
            "logging": {
                "exceptions": false,
                "moduleLoad": false
            }
        },
        {
            "name": "Debug launcher UI",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\_Build\\vscode-clang\\launcher\\launcher.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\_Build\\vscode-clang\\launcher",
            "environment": [],
            "externalConsole": false,
            "linux": {
                "type": "cppdbg",
                "program": "${workspaceFolder}/_Build/vscode-clang/launcher/launcher",
                "cwd": "${workspaceFolder}/_Build/vscode-clang/launcher",
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            }
        },
        {
            "name": "Debug kyty_emulator",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\_Build\\vscode-clang\\kyty_emulator.exe",
            "args": [
                "--game", "D:/gamesps5/PPSA07429",
                "--printf-direction", "File",
                "--graphics-debug-dump", "True"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\_Build\\vscode-clang",
            "environment": [],
            "externalConsole": true,
            "linux": {
                "type": "cppdbg",
                "program": "${workspaceFolder}/_Build/vscode-clang/kyty_emulator",
                "cwd": "${workspaceFolder}/_Build/vscode-clang",
                "externalConsole": false,
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Pass Kyty's internal signals to its handlers",
                        "text": "handle SIG37 SIGSEGV SIGBUS SIGILL nostop noprint pass",
                        "ignoreFailures": false
                    }
                ]
            }
        },
        {
            "name": "Attach to running kyty_emulator",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "linux": {
                "type": "cppdbg",
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Pass Kyty's internal signals to its handlers",
                        "text": "handle SIG37 SIGSEGV SIGBUS SIGILL nostop noprint pass",
                        "ignoreFailures": false
                    }
                ]
            }
        }
    ]
}
